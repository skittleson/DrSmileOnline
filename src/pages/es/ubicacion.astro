---
import BaseLayout from '../../layouts/Base.astro';
import UtilityBar from '../../components/UtilityBar.astro';
import Header from '../../components/Header.astro';
import TrustBand from '../../components/TrustBand.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/index';
import { locations, getDirectionsUrl, getMapEmbedSrc } from '../../data/locations';

const t = getTranslations('es');
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const canonical = `${import.meta.env.SITE}${base}/es/ubicacion/`;

const cityBlurb = {
  'newport-beach': 'Odontología estética, carillas e implantes All-on-Four',
  'san-pedro': 'Atención familiar, implantes y odontología de emergencia',
  'torrance': 'Odontología familiar, Invisalign y atención el mismo día',
  'lomita': 'Cuidado de encías, carillas y restauración de boca completa',
};

const cards = locations.map((loc) => ({
  ...loc,
  blurb: cityBlurb[loc.slug] ?? '',
  cityHref: `${base}/es/${loc.slug}/`,
  hours: loc.hoursEs,
}));
---

<BaseLayout
  title="Ubicaciones | Dr. Smile Dental Group"
  description="Cuatro ubicaciones convenientes en el Sur de California: Newport Beach, San Pedro, Torrance y Lomita."
  canonicalUrl={canonical}
  locale="es"
>

  <UtilityBar slot="header" locale="es" currentPath="/es/ubicacion/" counterpartPath="/location/" />
  <Header slot="header" locale="es" />

  <section class="section">
    <div class="container">
      <p class="eyebrow">Ubicación</p>
      <h1>Nuestras Ubicaciones</h1>
      <p>Cuatro consultorios en el Sur de California. Encuentre su oficina local — vea el mapa, la dirección, los horarios y la atención local de cada ciudad.</p>
    </div>
  </section>

  <section id="locations" class="section section-surface" aria-label="Nuestras ubicaciones">
    <div class="container">
      <div class="location-grid">
        {cards.map((loc) => (
          <div class="location-card">
            <iframe
              class="location-map"
              title={`Mapa de ${loc.name}`}
              src={getMapEmbedSrc(loc.mapQuery)}
              width="100%"
              height="200"
              style="border:0;"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <h2 class="city-name">{loc.name}</h2>
            <p class="city-blurb">{loc.blurb}</p>
            <address>
              <a
                class="location-address-link"
                href={getDirectionsUrl(loc.mapQuery)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Abrir ${loc.name} en Google Maps`}
              >
                {loc.address}
              </a>
            </address>
            <p><a href={`tel:${loc.phone.replace(/[^0-9]/g, '')}`}>{loc.phone}</a></p>
            <p class="hours">{loc.hours}</p>
            <div class="card-actions">
              <a class="btn btn-outline" href={loc.cityHref}>Visitar {loc.name}</a>
              <a class="btn btn-outline" href={getDirectionsUrl(loc.mapQuery)} target="_blank" rel="noopener noreferrer">{t['cta.getDirections']}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TrustBand locale="es" />

  <CtaBanner heading="¿Listo para Visitarnos?" subheading="Agende una consulta en la ubicación más conveniente para usted." buttonLabel="Agendar una Consulta" buttonHref="es/contacto/" />

  <Footer slot="footer" locale="es" />
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.85rem;
    color: var(--color-primary);
    margin-bottom: 8px;
  }
  .location-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .location-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
  }
  .location-map {
    display: block;
    width: 100%;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }
  .city-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 6px;
  }
  .city-blurb {
    color: var(--color-text-light);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: var(--space-2);
  }
  .location-card address {
    font-style: normal;
    color: var(--color-text-light);
    margin-bottom: var(--space-1);
  }
  .location-address-link {
    color: var(--color-primary);
    text-decoration: none;
  }
  .location-address-link:hover,
  .location-address-link:focus {
    text-decoration: underline;
  }
  .location-card p {
    margin-bottom: var(--space-1);
    color: var(--color-text-light);
  }
  .hours {
    font-size: 0.9rem;
  }
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
</style>
