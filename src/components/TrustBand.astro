---
import { getTranslations } from '../i18n/index';

interface Props {
  locale: 'en' | 'es';
}
const { locale } = Astro.props;
const t = getTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const locationHref = `${base}${locale === 'es' ? '/es/ubicacion/' : '/location/'}`;
// Google reviews link. This is the practice's real Google Business Profile
// (place) URL, which lands directly on the listing's reviews.
const reviewsHref = 'https://www.google.com/maps/place/Dr.+Smile/@35.756611,-121.2054256,495183m/data=!3m1!1e3!4m12!1m2!2m1!1sDr+Smile+Dental!3m8!1s0x80dd362ceb0c81c3:0x52b53fa7bd99d275!8m2!3d33.7291388!4d-118.2920058!9m1!1b1!15sCg9EciBTbWlsZSBEZW50YWxaESIPZHIgc21pbGUgZGVudGFskgENZGVudGFsX2NsaW5pY5oBJENoZERTVWhOTUc5blMwVkpRMEZuU1VScWQzTm1iQzFCUlJBQuABAPoBBAgzEEs!16s%2Fg%2F1v2kxrg5!5m1!1e3?entry=ttu&g_ep=EgoyMDI2MDgxMi4wIKXMDSoASAFQAw%3D%3D';
const reviewsLabel =
  locale === 'es'
    ? 'Lea nuestras reseñas de Google (calificación 4.8)'
    : 'Read our Google reviews (4.8 rating)';
---

<section class="trust-band" aria-label={locale === 'es' ? 'Señales de confianza' : 'Trust signals'}>
  <div class="container trust-inner">
    <a
      class="trust-item trust-item-link"
      href={reviewsHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={reviewsLabel}
    >
      <span class="trust-stars" aria-hidden="true">★★★★★</span>
      <span class="trust-label">4.8 {t['trust.reviews']}</span>
    </a>
    <div class="trust-item">
      <span class="trust-icon" aria-hidden="true">🛡️</span>
      <span class="trust-label">{t['trust.insurance']}</span>
    </div>
    <a class="trust-item trust-item-link" href={locationHref}>
      <span class="trust-icon" aria-hidden="true">📍</span>
      <span class="trust-label">4 {t['trust.locations']}</span>
    </a>
  </div>
</section>

<style>
  .trust-band {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) 0;
  }
  .trust-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 500;
  }
  .trust-stars {
    color: var(--color-accent);
    font-size: 1.25rem;
  }
  .trust-icon {
    font-size: 1.25rem;
  }
  .trust-label {
    color: var(--color-text);
  }
  .trust-item-link {
    text-decoration: none;
    border-radius: var(--radius-sm);
    padding: 4px 8px;
    min-height: 44px;
    transition: color 0.15s ease;
  }
  .trust-item-link .trust-label {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .trust-item-link:hover .trust-label,
  .trust-item-link:focus-visible .trust-label {
    color: var(--color-primary-dark);
  }
  @media (max-width: 600px) {
    .trust-inner {
      gap: var(--space-3);
    }
  }
</style>
