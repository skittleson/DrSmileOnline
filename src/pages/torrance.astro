---
import LocationPage from '../components/LocationPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const city = 'Torrance';
const region = 'Torrance, CA';
const canonical = `${import.meta.env.SITE}${base}/torrance/`;
---

<LocationPage
  locale="en"
  currentPath="/torrance/"
  counterpartPath="/es/torrance/"
  city={city}
  region={region}
  address="24667 Crenshaw Blvd D, Torrance, CA 90505"
  phone="(310) 325-8555"
  hours="Mon–Fri: 8AM–5PM, Sat: By appointment"
  mapQuery="24667 Crenshaw Blvd D, Torrance, CA 90505"
  title="Dentist in Torrance, CA | Dr. Smile Dental Group"
  description="Family dentist in Torrance, CA. Same-day care, implants, Invisalign, cosmetic dentistry, and sedation. We accept all PPO insurance. Call (310) 325-8555."
  canonical={canonical}
  intro="Your neighborhood dental team in Torrance. From routine cleanings to implants, Invisalign, and cosmetic care, Dr. Smile’s Torrance office offers comprehensive treatment in a warm, welcoming space — with same-day appointments for emergencies."
  about="At our Torrance office, Dr. Mariam Nadi and Dr. Kayvon Javid bring 16+ years of patient-centered care across Southern California. Dr. Nadi focuses on general and cosmetic dentistry with a gentle, personal touch, while Dr. Javid brings expertise in oral surgery, implants, and prosthodontics. That means comprehensive care under one roof — no external referrals, no long waits. Our Torrance office is designed to be comfortable and calming, so you feel at ease from your first visit through any treatment."
  tags={['Family dentistry', 'Same-day emergencies', 'Implants & All-on-Four', 'Invisalign', 'Cosmetic care', 'Sedation dentistry', 'Accepts all PPO insurance']}
  relatedPosts={[
    { title: 'How to Choose the Best Family Dentist in Torrance', slug: 'best-family-dentist-in-torrance' },
    { title: 'Best Walk-In Dentist in Torrance', slug: 'best-walk-in-dentist-in-torrance' },
    { title: 'Same-Day Dentist in Torrance', slug: 'same-day-dentist-in-torrance' },
    { title: 'Invisalign in Torrance for Families', slug: 'invisalign-in-torrance-for-families' },
    { title: 'Urgent Dental Care in Torrance', slug: 'urgent-dental-care-in-torrance-relief' },
    { title: 'Benefit of an Experienced Oral Surgeon in Torrance', slug: 'benefit-experienced-oral-surgeon-in-torrance' },
  ]}
/>
