---
import { getTranslations } from '../i18n/index';
import { locations, getDirectionsUrl, getMapEmbedSrc } from '../data/locations';

interface Props {
  locale: 'en' | 'es';
}
const { locale } = Astro.props;
const t = getTranslations(locale);

const cards = locations.map((loc) => ({
  ...loc,
  hours: locale === 'es' ? loc.hoursEs : loc.hoursEn,
}));
---

<section id="locations" class="section" aria-label={locale === 'es' ? 'Nuestras ubicaciones' : 'Our locations'}>
  <div class="container">
    <h2>{locale === 'es' ? 'Nuestras Ubicaciones' : 'Our Locations'}</h2>
    <p class="location-intro">
      {locale === 'es'
        ? 'Cuatro consultorios en el Sur de California. Vea las cuatro ubicaciones en el mapa a continuación.'
        : 'Four practices across Southern California. See all four locations on the maps below.'}
    </p>
    <div class="location-grid">
      {cards.map((loc) => (
        <div class="location-card">
          <iframe
            class="location-map"
            title={locale === 'es' ? `Mapa de ${loc.name}` : `Map of ${loc.name}`}
            src={getMapEmbedSrc(loc.mapQuery)}
            width="100%"
            height="200"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <h3>{loc.name}</h3>
          <address>
            <a
              class="location-address-link"
              href={getDirectionsUrl(loc.mapQuery)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={locale === 'es' ? `Abrir ${loc.name} en Google Maps` : `Open ${loc.name} in Google Maps`}
            >
              {loc.address}
            </a>
          </address>
          <p><a href={`tel:${loc.phone.replace(/[^0-9]/g, '')}`}>{loc.phone}</a></p>
          <p>{loc.hours}</p>
          <a href={getDirectionsUrl(loc.mapQuery)} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
            {t['cta.getDirections']}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .location-intro {
    color: var(--color-text-light);
    margin-top: var(--space-1);
  }
  .location-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .location-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    overflow: hidden;
  }
  .location-map {
    display: block;
    width: 100%;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }
  .location-card h3 {
    margin-bottom: var(--space-1);
  }
  .location-card address {
    font-style: normal;
    color: var(--color-text-light);
    margin-bottom: var(--space-1);
  }
  .location-address-link {
    color: var(--color-primary);
    text-decoration: none;
  }
  .location-address-link:hover,
  .location-address-link:focus {
    text-decoration: underline;
  }
  .location-card p {
    margin-bottom: var(--space-1);
    color: var(--color-text-light);
  }
  .location-card .btn {
    margin-top: var(--space-2);
  }
</style>
