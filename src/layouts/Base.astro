---
import '../styles/global.css';
import { locations } from '../data/locations';
import { counterpartPath } from '../i18n/locales';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  locale?: 'en' | 'es';
  noindex?: boolean;
}

const { title, description, canonicalUrl, locale = 'en', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const assetBase = `${base}/`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site);

// Reciprocal hreflang pair. The canonical URL is the absolute URL of this
// page; the counterpart is its EN or ES twin (from the shared slug map). x-default
// always points at the EN version. Pages without a counterpart (blog, 404) emit
// only a self-referencing tag so the set is still valid.
const siteOrigin = new URL(Astro.site).origin;
// Strip the base prefix so the path matches the base-relative keys in localePairs.
const fullPath = new URL(canonical).pathname;
const thisPath = fullPath.startsWith(base) ? fullPath.slice(base.length) : fullPath;
const counter =
  locale === 'en' ? counterpartPath(thisPath, 'en') : counterpartPath(thisPath, 'es');
const hreflangPairs: { lang: string; url: string }[] = [
  { lang: locale, url: canonical },
];
if (counter) hreflangPairs.push({ lang: locale === 'en' ? 'es' : 'en', url: `${siteOrigin}${base}${counter}` });
const xDefaultUrl = `${siteOrigin}${base}/`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Dr. Smile Dental Group',
  description:
    'Comprehensive dental care including oral surgery, implants, cosmetics, and orthodontics across Southern California.',
  telephone: locations[0].phone,
  url: 'https://doctorsmileonline.com',
  areaServed: 'Southern California',
  sameAs: [
    'https://www.facebook.com/drsmiledentalgroup',
    'https://www.instagram.com/dr.smile_dental_group/',
  ],
  location: locations.map((loc) => ({
    '@type': 'Dentist',
    name: `Dr. Smile ${loc.city}`,
    telephone: loc.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: loc.streetAddress,
      addressLocality: loc.city,
      addressRegion: 'CA',
      postalCode: loc.postalCode,
    },
  })),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {hreflangPairs.map((pair) => (
      <link rel="alternate" hreflang={pair.lang} href={pair.url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link rel="icon" type="image/png" href={`${assetBase}favicon.png`} />
    <link rel="ai-catalog" href={`${base}/.well-known/ai-catalog.json`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Dr. Smile Dental Group" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot name="header" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
