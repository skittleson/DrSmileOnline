---
import LocationPage from '../components/LocationPage.astro';
import { getLocation } from '../data/locations';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const loc = getLocation('lomita');
const city = 'Lomita';
const region = 'Lomita, CA';
const canonical = `${import.meta.env.SITE}${base}/lomita/`;
---

<LocationPage
  locale="en"
  currentPath="/lomita/"
  counterpartPath="/es/lomita/"
  city={city}
  region={region}
  address={loc.address}
  phone={loc.phone}
  hours={loc.hoursEn}
  mapQuery={loc.mapQuery}
  title="Dentist in Lomita, CA | Dr. Smile Dental Group"
  description={`Family dentist in Lomita, CA. Gum disease treatment, veneers, emergency care, and full-mouth restoration. We accept all PPO insurance and offer financing. Call ${loc.phone}.`}
  canonical={canonical}
  intro="Comprehensive dental care close to home in Lomita. From gentle family dentistry and gum disease treatment to veneers, emergency care, and full-mouth restoration, Dr. Smile’s Lomita office has your whole family covered."
  about="Our Lomita office serves the Westchester and surrounding community with a focus on comfort and prevention. Dr. Mariam Nadi and Dr. Kayvon Javid bring 16+ years of experience to every visit, combining advanced technology with a gentle, personal touch. Patients in Lomita trust us for everything from routine cleanings and cosmetic work to periodontal treatment and full-mouth restorations — all in a welcoming space designed to put you at ease."
  tags={['Family dentistry', 'Gum disease treatment', 'Veneers & whitening', 'Emergency care', 'Full-mouth restoration', 'Membership plans', 'Accepts all PPO insurance']}
  relatedPosts={[
    { title: 'Affordable Family Dentist in Lomita', slug: 'affordable-family-dentist-in-lomita' },
    { title: 'Complete Guide to Dental Veneers in Lomita', slug: 'complete-guide-to-dental-veneers-in-lomita' },
    { title: 'Deep Gum Disease Treatment in Lomita', slug: 'deep-gum-disease-treatment-in-lomita' },
    { title: 'Emergency Tooth Extraction in Lomita', slug: 'emergency-tooth-extraction-in-lomita' },
    { title: 'Full-Mouth Restoration in Lomita', slug: 'full-mouth-restoration-in-lomita-pain-free' },
    { title: 'Affordable Teeth Whitening in Lomita', slug: 'affordable-teeth-whitening-in-lomita' },
  ]}
/>
